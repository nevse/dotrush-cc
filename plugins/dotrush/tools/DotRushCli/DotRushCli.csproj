<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built on first use by scripts/dotrush-cli.sh. Keep it free of package references: the build must
       not need network access or a NuGet feed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DotRushCli</RootNamespace>
  </PropertyGroup>

</Project>
