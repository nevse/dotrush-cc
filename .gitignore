# The DotRush server is downloaded at runtime into ${CLAUDE_PLUGIN_DATA}, never committed.
# Guard against accidental local copies inside the repo:
**/server/
*.zip

# Proxy runtime artifacts (only appear if someone points paths back into the repo)
inject.fifo
proxy.log

# Temp files of a rename apply, left only by a kill between writing them and moving them into place
*.dotrush-cc.tmp

# Local per-machine environment (direnv account switcher; not for distribution)
.envrc

# Python bytecode from running the test suite
__pycache__/
*.pyc

# .NET build output of the CLI (the plugin builds it into its data dir) and its tests
plugins/dotrush/tools/**/bin/
plugins/dotrush/tools/**/obj/
tests/DotRushCli.Tests/bin/
tests/DotRushCli.Tests/obj/

# Profiling artifacts, if someone points --output back into the repo
dotrush-profiles/

# OS / editor
.DS_Store
*.swp
